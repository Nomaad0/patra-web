{
  "name": "patra",
  "version": "1.0.0",
  "private": true,
  "homepage": "./",
  "description": "PaTra - Suivi de patrimoine personnel",
  "author": "Pierrick",
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.383.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-scripts": "5.0.1",
    "recharts": "^2.15.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build && node -e \"const fs=require('fs');fs.renameSync('build/index.html','build/app.html');['og-preview.html','app-screenshot.html'].forEach(f=>{if(fs.existsSync('build/'+f))fs.unlinkSync('build/'+f);});const sw=fs.readFileSync('build/service-worker.js','utf8');fs.writeFileSync('build/service-worker.js',sw.replace('self.__BUILD_ID || Date.now()',Date.now()));\"",
    "build:icons": "node scripts/generate-icons.js"
  },
  "engines": {
    "node": "22.x"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
